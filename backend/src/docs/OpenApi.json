{
  "openapi": "3.0.0",
  "info": {
    "title": "Marhba API Documentation",
    "version": "1.0.0",
    "description": "API d'authentification complète pour l'application mobile Marhba."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Serveur local"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Inscription d'un nouvel utilisateur",
        "tags": ["Authentification"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fullName", "email", "password"],
                "properties": {
                  "fullName": { "type": "string", "example": "Adam" },
                  "email": { "type": "string", "format": "email", "example": "adam@example.com" },
                  "password": { "type": "string", "minLength": 6, "example": "secret123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Utilisateur créé avec succès" },
          "400": { "description": "Données invalides ou email déjà utilisé" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Connexion d'un utilisateur",
        "tags": ["Authentification"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "adam@example.com" },
                  "password": { "type": "string", "example": "secret123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Connexion réussie avec retour du token" },
          "400": { "description": "Email ou mot de passe incorrect" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Récupérer le profil de l'utilisateur connecté",
        "tags": ["Authentification"],
        "security": [
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": { "description": "Informations de l'utilisateur" },
          "401": { "description": "Token manquant, invalide ou expiré" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}